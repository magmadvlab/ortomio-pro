[
 {
  "text": "Meteo.",
  "start": 0.02,
  "end": 0.6
 },
 {
  "text": "Suolo.",
  "start": 0.87,
  "end": 1.42
 },
 {
  "text": "Acqua.",
  "start": 1.8,
  "end": 2.26
 },
 {
  "text": "Piante.",
  "start": 2.58,
  "end": 3.12
 },
 {
  "text": "Operazioni.",
  "start": 3.46,
  "end": 4.3
 },
 {
  "text": "Ogni giorno il campo manda segnali.",
  "start": 4.74,
  "end": 6.97
 },
 {
  "text": "Troppi da tenere a mente.",
  "start": 7.29,
  "end": 8.7
 },
 {
  "text": "OrtoMio li mette insieme.",
  "start": 9.05,
  "end": 10.76
 },
 {
  "text": "Li incrocia.",
  "start": 11.0,
  "end": 11.8
 },
 {
  "text": "E ti dice che cosa viene prima.",
  "start": 12.02,
  "end": 13.65
 },
 {
  "text": "Con il perché.",
  "start": 13.93,
  "end": 14.65
 },
 {
  "text": "Con i dati che ha, e quelli che mancano.",
  "start": 14.92,
  "end": 17.08
 },
 {
  "text": "Non solo nel campo.",
  "start": 17.42,
  "end": 18.6
 },
 {
  "text": "Nel filare.",
  "start": 18.86,
  "end": 19.65
 },
 {
  "text": "Fino alla singola pianta.",
  "start": 19.86,
  "end": 21.4
 },
 {
  "text": "Decidi tu.",
  "start": 21.72,
  "end": 22.36
 },
 {
  "text": "La squadra interviene lì.",
  "start": 22.62,
  "end": 24.24
 },
 {
  "text": "E quello che fa resta scritto.",
  "start": 24.52,
  "end": 26.43
 },
 {
  "text": "Al raccolto, l'atteso accanto al reale.",
  "start": 26.72,
  "end": 29.63
 },
 {
  "text": "Filare per filare.",
  "start": 29.92,
  "end": 31.15
 },
 {
  "text": "Pianta per pianta.",
  "start": 31.36,
  "end": 32.5
 },
 {
  "text": "Così la stagione dopo non riparte da zero.",
  "start": 32.77,
  "end": 35.51
 },
 {
  "text": "OrtoMio.",
  "start": 35.9,
  "end": 36.6
 }
]