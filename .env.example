# OrtoMio Next.js. Copy to .env.local; never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.ortomioapp.it

# Server-only: never prefix these variables with NEXT_PUBLIC_ or VITE_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# 32 random bytes encoded as 64 hexadecimal characters. Retain securely for decryption.
API_CONFIGURATION_ENCRYPTION_KEY=
CRON_SECRET=
# Optional exact origins for server-side Ollama/custom AI providers (comma-separated).
API_PROVIDER_ALLOWED_ORIGINS=

# Optional providers. Both a key and an approved, available model are required.
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Mistral requests use OpenRouter credentials, with their own approved model.
MISTRAL_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
OPENWEATHER_API_KEY=

# Notification / agronomist delivery. Configure verified senders before enabling delivery.
RESEND_API_KEY=
ORGANIZATION_INVITATION_FROM=
AGRONOMIST_REQUEST_FROM=

# Verified Resend sender used by the server-only notification worker
NOTIFICATION_FROM=OrtoMio <notifiche@ortomioapp.it>
