{
  "name": "ortomio-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -H localhost -p 3002",
    "dev:turbo": "next dev -H localhost -p 3002",
    "dev:next": "next dev -p 3002",
    "dev:port": "next dev -p",
    "build": "next build --webpack",
    "build:next": "next build --webpack",
    "start": "next start -p 3002",
    "start:next": "next start -p 3002",
    "type-check": "next typegen && tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "check": "npm run type-check && npm run build",
    "lint": "eslint --no-ignore app components services lib hooks config --ext .ts,.tsx,.js,.jsx",
    "pre-deploy": "node scripts/pre-deploy-check.js",
    "pre-deploy:fast": "node scripts/pre-deploy-check.js --skip-build",
    "pre-commit": "npm run pre-deploy",
    "generate:plant-migration": "tsx scripts/generatePlantTaxonomyMigration.ts",
    "apply:plant-migration": "tsx scripts/applyPlantTaxonomyMigration.ts",
    "test:health-check": "tsx scripts/test-health-check.ts",
    "test:precision-hub": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/precision-hub/**/*.test.ts",
    "test:security": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/security/**/*.test.ts",
    "test:capabilities": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/capabilities/**/*.test.ts",
    "test:persistence": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/persistence/**/*.test.ts",
    "test:physical-operations": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/physical-operations/**/*.test.ts",
    "test:health-predictions-monitoring": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/health-predictions-monitoring/**/*.test.ts",
    "test:remote-data-isolation": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/remote-data-isolation/**/*.test.ts",
    "test:regulatory-exports-admin": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/regulatory-exports-admin/**/*.test.ts",
    "test:rollout-observability": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/rollout-observability/**/*.test.ts",
    "test:landing": "NODE_OPTIONS=--conditions=react-server npx --yes tsx --test __tests__/landing/**/*.test.ts",
    "test:release": "npm run test:app && npm run test:landing",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:check:commercial-schema": "node scripts/check-commercial-schema.mjs --require-ready",
    "release:check:remote": "node scripts/check-release-readiness.mjs --require-remote",
    "docs:sync": "node scripts/sync-manual-docs.mjs",
    "docs:sync:check": "node scripts/sync-manual-docs.mjs --check",
    "docs:hygiene": "node scripts/check-docs-hygiene.mjs && npm run docs:sync:check",
    "audit:p0": "node scripts/audit-p0-baseline.mjs",
    "audit:release-debt": "node scripts/audit-release-debt.mjs --check",
    "audit:migrations": "node scripts/audit-migration-history.mjs",
    "test:manual": "tsx --test __tests__/manual/*.test.tsx",
    "test:weather": "NODE_OPTIONS=--conditions=react-server tsx --test __tests__/weather/*.test.ts",
    "docs:check": "npm run test:manual && npm run docs:sync:check",
    "test:audit-fixes": "NODE_OPTIONS=--conditions=react-server tsx --test __tests__/audit-fixes/*.test.ts",
    "test:app": "npm run test:security && npm run test:capabilities && npm run test:persistence && npm run test:physical-operations && npm run test:health-predictions-monitoring && npm run test:remote-data-isolation && npm run test:regulatory-exports-admin && npm run test:rollout-observability && npm run test:precision-hub && npm run test:audit-fixes && npm run test:weather && npm run test:manual"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@mapbox/shp-write": "0.4.3",
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/leaflet": "^1.9.21",
    "date-fns": "^4.1.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.556.0",
    "motion": "^13.1.0",
    "next": "^16.1.1",
    "proj4": "2.23.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.3",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/shapefile": "0.6.4",
    "autoprefixer": "^10.4.22",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.5.6",
    "shapefile": "0.6.6",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2"
  }
}
